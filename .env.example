# Public API origin (NestJS backend). Never commit real secrets here.
NUXT_ENV_BASE_URL=http://localhost:3000

# Public site URL for canonical links, Open Graph, robots, and sitemap.
# Also used by security:dast header checks.
NUXT_PUBLIC_SITE_URL=http://localhost:8001

# Max payment screenshot upload size in bytes (client-side guard)
NUXT_PUBLIC_PAYMENT_SCREENSHOT_MAX_BYTES=409600
